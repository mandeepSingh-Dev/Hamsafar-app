# Core Common ProGuard / R8 Keep Rules
# Package: com.app.core_common

# Keep Datastore Preference models and implementations
-keep class com.app.core_common.datastore.** { *; }
-keepclassmembers class com.app.core_common.datastore.** { *; }

# Keep User Manager
-keep class com.app.core_common.UserManager { *; }
-keepclassmembers class com.app.core_common.UserManager { *; }

# Keep Base UI State and UI Event classes used across feature modules
-keep class com.app.core_common.base.** { *; }
-keepclassmembers class com.app.core_common.base.** { *; }

# Keep all Domain Enums and their values()/valueOf() methods
-keepclassmembers enum com.app.core_common.utils.enums.** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Keep Dependency Injection Modules (Dagger / Hilt)
-keep class com.app.core_common.di.** { *; }
-keepclassmembers class com.app.core_common.di.** { *; }

# Keep Common Utility and Helper classes
-keep class com.app.core_common.utils.** { *; }
-keepclassmembers class com.app.core_common.utils.** { *; }

-keep class com.app.core_common.extensions.** { *; }

# Preserve annotations and generic signatures
-keepattributes Signature, RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations, AnnotationDefault, InnerClasses, EnclosingMethod
